# Generated by build.py. The window keeps one size for the whole run (the gate checks it), so the cases vary what
# is drawn. The padding comes from config.adjust_view_size (options.rpy).
cmd auto on
cmd click on
wait menu True
cmd click off
settle 3
shot 01-menu
cmd start
after_start
cmd advance-to 8
wait advance-done
settle 2
shot 02-say-8
cmd jump view_pattern_case
settle 2
shot 03-pattern
cmd jump view_bars_case
settle 2
shot 04-bars
cmd jump view_frames_case
settle 2
shot 05-frames
cmd jump view_circle_case
settle 2
shot 06-circle
cmd jump view_sub_case
settle 2
shot 07-sub
quit
