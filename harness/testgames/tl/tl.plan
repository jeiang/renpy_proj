# Generated by build.py. Each jump to a to_* label switches the language, then stops on the first line of
# that part. Screenshots show that language.
wait menu True
cmd click off
settle 3
shot 01-menu
cmd start
after_start
cmd advance-to 4
wait advance-done
settle 2
shot 02-start-en
cmd jump to_fr
settle 2
shot 03-fr
cmd jump to_en
settle 2
shot 04-en
cmd jump to_de
settle 2
shot 05-de
cmd jump to_en
settle 2
shot 06-en-again
quit
