<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The bundle carries FFmpeg (LGPL) and its dependencies as separate dylibs, so the LGPL relink
         right holds. With the hardened runtime, library validation refuses dylibs that another signature
         made (ad hoc signatures have no team ID, and Developer ID re-signing has the same effect with
         dylibs from other teams). Remove this entitlement when FFmpeg links statically. -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
