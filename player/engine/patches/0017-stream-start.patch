+# Player patch: streamed start (investigation prototype, off unless RENPY_STREAM_START=1).
+#
+# The compiled file of a loose script gets a third slot that holds the file without the bodies of its "pure" labels, and
+# a side file (`<name>.rpyc.sbody`) that holds the bodies, one compressed pickle each. A launch that streams loads the
+# third slot. The labels stay in the namemap with empty blocks. The body of a label is loaded when the label first
+# executes, when a lookup needs one of its nodes, or by a background thread that starts once the first frames are drawn.
+#
+# A label is pure when nothing in its body takes part in init time: no init priority, no python early, no statement
+# that creates a store. Everything else is loaded at start, as before.
+
+import os
+import sys
+import threading
+import time
+import zlib
+
+import renpy
+from renpy.compat.pickle import loads, dumps
+
+# A body with fewer nodes than this stays in the skeleton: the file access costs more than the unpickle.
+MIN_BODY_NODES = 8
+
+SBODY_SUFFIX = ".sbody"
+
+
+def compat_active():
+    """
+    True for a Ren'Py 7 game. The Python 2 compatibility module reads the PyCode objects of every file when finish_load
+    runs (`_player.compat.hooks`) and scans all game Python after the load, so it needs the whole script at load time.
+    """
+
+    module = sys.modules.get("_player.compat")
+
+    return bool(module is not None and getattr(module, "active", False))
+
+
+def write_enabled():
+    """True when compiling a file should also write the split slot and side file."""
+
+    return os.environ.get("RENPY_STREAM_START", "0") == "1" and not compat_active()
+
+
+def enabled():
+    """True when this launch loads bodies later (the flag, a plain run, and the lazy compile that streaming builds on)."""
+
+    args = renpy.game.args
+
+    return (
+        write_enabled()
+        and args.command == "run"
+        and not args.compile
+        and not getattr(args, "warp", None)
+        and os.environ.get("RENPY_LAZY_COMPILE", "1") != "0"
+    )
+
+
+class Entry(object):
+    __slots__ = ("path", "offset", "length", "count")
+
+    def __init__(self, path, offset, length, count):
+        self.path = path
+        self.offset = offset
+        self.length = length
+        self.count = count
+
+
+def pure_nodes(label):
+    """
+    Returns the flat list of the nodes in the block of `label` if none of them takes part in init time, else None.
+    """
+
+    ast = renpy.ast
+
+    nodes = []
+
+    for i in label.block:
+        i.get_children(nodes.append)
+
+    # A user statement is fine when it has no init priority (the get_init test below): play, stop, queue, window, pause...
+    skip = (ast.Init, ast.EarlyPython, ast.Testcase)
+
+    for n in nodes:
+        if isinstance(n, skip):
+            return None
+
+        if n.get_init() is not None:
+            return None
+
+        if getattr(n, "store", "store") != "store":
+            return None
+
+    return nodes
+
+
+class Split(object):
+    """The result of split(): `skeleton` is the pickle for slot 3, `sidecar` the bytes of the side file."""
+
+    def __init__(self, skeleton, sidecar):
+        self.skeleton = skeleton
+        self.sidecar = sidecar
+
+
+def split(data, stmts, digest, filename):
+    """
+    Splits the top-level statements `stmts` of a compiled file. `data` is the rpyc data dict, `digest` the 16 byte md5
+    that the rpyc file ends with. Returns a Split, or None when no label qualifies. The statements are unchanged on return.
+    """
+
+    ast = renpy.ast
+
+    bodies = []
+
+    for node in stmts:
+        if type(node) is ast.Label and node.block and isinstance(node.name, str):
+            nodes = pure_nodes(node)
+
+            if nodes is not None and len(nodes) >= MIN_BODY_NODES:
+                bodies.append((node, nodes))
+
+    if not bodies:
+        return None
+
+    blob = bytearray(digest)
+    index = {}
+    nested = {}
+
+    for label, nodes in bodies:
+        serials = [n.name[2] for n in nodes if isinstance(n.name, tuple) and len(n.name) == 3 and isinstance(n.name[2], int)]
+
+        if not serials:
+            continue
+
+        raw = zlib.compress(dumps(label.block, bad_reduction_name="<%s body %s>" % (filename, label.name)), 1)
+
+        index[label.name] = (len(blob), len(raw), min(serials), max(serials), len(nodes))
+        blob += raw
+
+        for n in nodes:
+            if type(n) is ast.Label and isinstance(n.name, str):
+                nested[n.name] = label.name
+
+    if not index:
+        return None
+
+    lazy = {"digest": digest, "bodies": index, "nested": nested, "filename": filename}
+    data = dict(data)
+    data["lazy"] = lazy
+
+    saved = []
+
+    try:
+        for label, _nodes in bodies:
+            if label.name in index:
+                saved.append((label, label.block))
+                label.block = []
+
+        skeleton = dumps((data, stmts), bad_reduction_name="<%s skeleton>" % filename)
+    finally:
+        for label, block in saved:
+            label.block = block
+
+    return Split(skeleton, bytes(blob))
+
+
+def sidecar_path(rpyc_path):
+    return rpyc_path + SBODY_SUFFIX
+
+
+def sidecar_ok(data, rpyc_path):
+    """True if the side file next to `rpyc_path` is the one that the slot 3 `data` was written with."""
+
+    lazy = data.get("lazy") if isinstance(data, dict) else None
+
+    if not lazy or rpyc_path is None:
+        return False
+
+    try:
+        with open(sidecar_path(rpyc_path), "rb") as f:
+            return f.read(len(lazy["digest"])) == lazy["digest"]
+    except OSError:
+        return False
+
+
+def register(script, all_stmts, lazy, rpyc_path):
+    """Called by Script.finish_load for a file that was loaded from slot 3."""
+
+    path = sidecar_path(rpyc_path)
+    bodies = lazy["bodies"]
+    ranges = script.lazy_ranges.setdefault(lazy["filename"], [])
+
+    for node in all_stmts:
+        if type(node) is renpy.ast.Label:
+            info = bodies.get(node.name)
+
+            if info is not None:
+                offset, length, lo, hi, count = info
+                script.lazy_bodies[node.name] = Entry(path, offset, length, count)
+                ranges.append((lo, hi, node.name))
+
+    script.lazy_nested.update(lazy["nested"])
+
+
+def resolve(script, key):
+    """
+    Called when a lookup misses `key`. Loads the body that holds the node or label named `key`, if one is waiting.
+    Returns True if a body was loaded.
+    """
+
+    if not script.lazy_bodies:
+        return False
+
+    owner = None
+
+    if isinstance(key, str):
+        owner = script.lazy_nested.get(key)
+
+        if owner is not None and owner in script.lazy_bodies:
+            load_body(script, owner)
+            return True
+
+        return False
+
+    if isinstance(key, tuple) and len(key) >= 3 and isinstance(key[2], int):
+        loaded = False
+
+        for lo, hi, name in list(script.lazy_ranges.get(key[0], ())):
+            if lo <= key[2] <= hi and name in script.lazy_bodies:
+                load_body(script, name)
+                loaded = True
+
+                if key in script.namemap:
+                    break
+
+        return loaded
+
+    return False
+
+
+def load_body(script, name):
+    """Loads the body of the label `name`, and does for its nodes what Script.finish_load does for a file."""
+
+    with script.load_lock:
+        entry = script.lazy_bodies.pop(name, None)
+
+        if entry is None:
+            return
+
+        start = time.time()
+
+        with open(entry.path, "rb") as f:
+            f.seek(entry.offset)
+            raw = f.read(entry.length)
+
+        block = loads(zlib.decompress(raw))
+
+        label = script.namemap[name]
+
+        renpy.ast.chain_block(block, label.next)
+        label.next = block[0]
+        label.block = block
+
+        all_stmts = []
+
+        for i in block:
+            i.get_children(all_stmts.append)
+
+        script.translator.take_translates(all_stmts)
+        script.translator.chain_translates()
+
+        persistent = renpy.game.persistent
+
+        if persistent is not None:
+            seen = persistent._seen_translates
+
+            for n in all_stmts:
+                if isinstance(n, (renpy.ast.Translate, renpy.ast.TranslateSay)) and n.language is None:
+                    if (n.identifier in seen) or (renpy.astsupport.hash64(n.identifier) in seen):
+                        renpy.game.seen_translates_count += 1
+
+        script.select_lazy_pycode(block, all_stmts)
+        script.update_bytecode()
+
+        for node in all_stmts:
+            script.namemap[node] = node
+            node.early_execute()
+
+        if script.all_stmts is not None:
+            script.all_stmts.extend(all_stmts)
+
+        script.need_analysis.extend(all_stmts)
+        script.need_compress.extend(all_stmts)
+
+        script.analyze()
+        script.compress()
+
+        took = (time.time() - start) * 1000.0
+
+        script.stream_loaded += 1
+        script.stream_ms += took
+        script.stream_max_ms = max(script.stream_max_ms, took)
+
+        if threading.current_thread() is threading.main_thread():
+            script.stream_sync += 1
+            script.stream_sync_ms += took
+
+
+def load_all(script):
+    """Loads every body that is still waiting."""
+
+    for name in list(script.lazy_bodies):
+        load_body(script, name)
+
+
+def start(script):
+    """Starts the background thread that loads the waiting bodies once the first frames are drawn."""
+
+    if not script.lazy_bodies:
+        return
+
+    t = threading.Thread(target=run_thread, args=(script,), name="stream-load")
+    t.daemon = True
+    t.start()
+
+
+def run_thread(script):
+    waited = 0.0
+
+    # Let the main thread draw its first frames (the menu) without competing for the GIL.
+    while renpy.game.script is script and waited < 15.0:
+        interface = renpy.game.interface
+
+        if interface is not None and len(interface.frame_times) >= 5:
+            break
+
+        time.sleep(0.05)
+        waited += 0.05
+
+    begin = time.time()
+
+    for name in list(script.lazy_bodies):
+        if renpy.game.script is not script:
+            return
+
+        try:
+            load_body(script, name)
+        except Exception:
+            import traceback
+
+            traceback.print_exc()
+            return
+
+        time.sleep(0)
+
+    renpy.display.log.write(
+        "Streamed script: %d bodies, %.0f ms of loading (largest %.0f ms), %.1f s after the first frames; %d bodies (%.0f ms) loaded by the game thread"
+        % (script.stream_loaded, script.stream_ms, script.stream_max_ms, time.time() - begin, script.stream_sync, script.stream_sync_ms)
+    )
