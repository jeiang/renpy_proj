+renpy7_syntax = False
+
+# Player patch: statements whose colon Ren'Py 7 accepted with no block under it (`scene x with fade:`,
+# `show x:`, `screen x:`). Only a Ren'Py 7 game gets this (`renpy7_syntax`).
+RENPY7_EMPTY_BLOCKS = frozenset(["scene statement", "show statement", "screen statement"])
 import renpy.vfs  # Player patch: virtual renpy/common files.
 
 
