+def player_rpyc_path(dir, name):
+    """
+    Player patch. Returns the path in the player's cache for the compiled file `name` of the source
+    directory `dir`, or None if no cache directory is configured.
+    """
+
+    cache = renpy.config.player_cache_dir
+
+    if not cache:
+        return None
+
+    if dir == renpy.config.commondir:
+        slot = "common"
+    elif dir == renpy.config.gamedir:
+        slot = "game"
+    else:
+        slot = hashlib.md5(dir.encode("utf-8")).hexdigest()[:8]
+
+    return os.path.join(cache, "rpyc", slot, name)
+
+
+def read_rpyc_digest(fn):
+    """
+    Player patch. Returns the md5 digest stored at the end of the compiled file `fn`, or None.
+    """
+
+    if fn is None:
+        return None
+
+    try:
+        if not os.path.exists(fn):
+            return None
+
+        with open(fn, "rb") as f:
+            f.seek(-hashlib.md5().digest_size, 2)
+            return f.read(hashlib.md5().digest_size)
+    except Exception:
+        return None
+
