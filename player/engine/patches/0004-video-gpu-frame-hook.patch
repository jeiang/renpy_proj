+def is_video_frame(obj):
+    """
+    True if `obj` is a decoded video frame from the player's media backend
+    (renpy.audio.renpysound.read_video returns a renpysound.VideoFrame).
+    """
+
+    return type(obj).__name__ == "VideoFrame"
+
+
+def get_movie_texture_gpu(channel, tex, mask_channel, side_mask, mipmap):
+    """
+    Like get_movie_texture_web, for a texture made from a PyVideoFrame.
+    """
+
+    mask_tex = None
+
+    if side_mask:
+        w, h = tex.get_size()
+        w //= 2
+
+        mask_tex = tex.subsurface((w, 0, w, h))
+        tex = tex.subsurface((0, 0, w, h))
+
+    elif mask_channel:
+        mask_frame = renpy.audio.music.get_channel(mask_channel).read_video()
+
+        if is_video_frame(mask_frame):
+            mask_tex = renpy.display.draw.load_video_frame(mask_frame, mipmap)
+
+    return get_movie_texture_tail(channel, tex, mask_tex)
+
