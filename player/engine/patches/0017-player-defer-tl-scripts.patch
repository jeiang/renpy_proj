# Reason: A game's tl/ folder holds one copy of every translated script per language, and stock Ren'Py parses all of them before the first screen. Harem Hotel (77 tl/ files, 56% of its nodes) spent 3.3 s loading languages the player never shows. config.defer_tl_scripts already exists upstream (renpy/script.py script_filter, renpy/exports/scriptexports.py load_language): a language's files load when it is first selected, and known_languages() still lists every tl/ folder. The player turns it on by default; a game that sets it in its own define still wins, because EARLY_CONFIG applies that define before the first load.

diff --git a/renpy/config.py b/renpy/config.py
--- a/renpy/config.py
+++ b/renpy/config.py
@@ -1456,7 +1456,7 @@
 drag_group_add_top = True
 
 # Should loading of tl scripts be deferred?
-defer_tl_scripts = False
+defer_tl_scripts = True
 
 # Should transitions take placement from child displayables?
 transitions_use_child_placement = True
