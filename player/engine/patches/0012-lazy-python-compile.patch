+    def select_lazy_pycode(self, stmts, all_stmts):
+        """
+        Marks the python statements that update_bytecode may leave uncompiled: those in the bodies of labels.
+        Init blocks keep their eager compile (a syntax error stays a load time error), as does every other
+        statement that holds a PyCode.
+        """
+
+        init_ids = set()
+
+        for i in stmts:
+            if isinstance(i, renpy.ast.Init):
+                i.get_children(lambda node: init_ids.add(id(node)))
+
+        python_class = renpy.ast.Python
+
+        for node in all_stmts:
+            if type(node) is python_class and id(node) not in init_ids:
+                self.lazy_pycode_ids.add(id(node.code))
+
+    def compile_pycode(self, i):
+        """
+        Compiles the PyCode `i` and returns the bytecode. Raises SyntaxError.
+        """
+
+        return renpy.python.py_compile(
+            i.source,
+            i.mode,
+            filename=i.filename,
+            lineno=i.linenumber,
+            py=i.py,
+            hashcode=i.hashcode,
+            column=i.col_offset,
+        )
+
+    def pycode_parse_error(self, i, e):
+        """
+        The ParseError for the SyntaxError `e` of the PyCode `i`.
+        """
+
+        assert e.filename is not None
+        assert e.lineno is not None
+
+        return renpy.parser.ParseError(
+            e.msg,
+            e.filename,
+            e.lineno,
+            e.offset + i.col_offset,
+            e.text,
+            e.end_lineno,
+            e.end_offset + i.col_offset,
+        )
+
+    def compile_deferred(self, i):
+        """
+        Compiles a deferred PyCode on its first use. A syntax error is raised as the ParseError that load time
+        compilation reports in errors.txt, so the message is the same.
+        """
+
+        renpy.python.compile_warnings = []
+
+        old_ei = renpy.game.exception_info
+
+        try:
+            renpy.game.exception_info = "While compiling python block starting at line %d of %s." % (
+                i.linenumber,
+                i.filename,
+            )
+
+            try:
+                rv = self.compile_pycode(i)
+            except SyntaxError as e:
+                raise self.pycode_parse_error(i, e) from None
 
+        finally:
+            renpy.game.exception_info = old_ei
+
+        i.bytecode = rv
+
+        return rv
+
