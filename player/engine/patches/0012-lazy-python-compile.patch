+    def carry_deferred_bytecode(self):
+        """
+        Copies the cache entries of the blocks that were never compiled in this run from the old cache to the new
+        one, so that writing the cache does not drop them.
+        """
+
+        old = self.bytecode_oldcache
+        new = self.bytecode_newcache
+
+        if not old:
+            return
+
+        key_of = renpy.python.py_compile_key
+
+        keys = []
+
+        for i in self.deferred_pycode:
+            if i._bytecode is renpy.ast.DEFERRED:
+                keys.append(key_of(i.source, i.mode, i.filename, i.linenumber, i.hashcode, i.col_offset))
+
+        for i in self.deferred_pyexpr:
+            keys.append(key_of(i, "eval"))
+
+        for key in keys:
+            if key in new:
+                continue
+
+            bytecode = old.get(key, None)
+
+            if bytecode is None:
+                continue
+
+            new[key] = bytecode
+
+            warnings_key = ("warnings", key)
+
+            if warnings_key in old:
+                new[warnings_key] = old[warnings_key]
+
