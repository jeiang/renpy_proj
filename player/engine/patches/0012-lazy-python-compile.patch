+class _Deferred:
+    """
+    The value of PyCode._bytecode while the Python block waits for its first use (see Script.update_bytecode).
+    """
+
+    def __repr__(self):
+        return "<deferred bytecode>"
+
+
+DEFERRED = _Deferred()
+
+
 class PyCode(Object):
     _cslot_linenumbers = True
 
@@ -82,10 +94,27 @@
     source: str
     location: tuple[Any, ...]
     mode: Literal["eval", "exec", "hide"] = "eval"
-    bytecode: bytes | None
+    _bytecode: Any = None
     py: int = 3
     hashcode: int
 
+    @property
+    def bytecode(self):
+        """
+        The compiled code. A block that Script.update_bytecode deferred is compiled here, on first use.
+        """
+
+        rv = self._bytecode
+
+        if rv is DEFERRED:
+            rv = renpy.game.script.compile_deferred(self)
+
+        return rv
+
+    @bytecode.setter
+    def bytecode(self, value):
+        self._bytecode = value
+
     def __getstate__(self):
         return (1, self.source, (self.filename, self.linenumber), self.mode, self.py, self.hashcode, self.col_offset)
 
