+def py_compile_key(source, mode, filename="<none>", lineno=1, hashcode=None, column=0):
+    """
+    Returns the key under which py_compile stores the compiled `source` in the bytecode cache. The arguments
+    are those of py_compile.
+    """
 
+    if isinstance(source, renpy.ast.PyExpr):
+        filename = source.filename
+        lineno = source.linenumber
+        hashcode = source.hashcode
 
+    elif hashcode is None:
+        hashcode = hash32(source)
+
+    if source and (source[0] == " ") and (mode != "eval"):
+        lineno -= 1
+
+    flags = file_compiler_flags.get(filename, 0)
+
+    if renpy.config.future_annotations:
+        flags |= __future__.annotations.compiler_flag
+
+    return (hashcode, lineno, filename, mode, renpy.script.PYC_MAGIC, flags, column)
+
