--- /dev/null
+++ b/renpy/parallelcompile.py
@@ -0,0 +1,353 @@
+# Player patch: compile the loose script files of a game in parallel.
+#
+# A script file with no valid compiled file (a game that was just added, or an edited .rpy) is parsed, and its
+# .rpyc is written, by Script.load_file. That takes seconds for a large game and uses one core. Here the files
+# are compiled by forked worker processes first. They write the same .rpyc files into the same cache, and
+# Script.load_script then loads the files in the same order as before. The loading finds a valid .rpyc for
+# each file (what it finds on every later launch). So the order of the nodes, the init priorities, the duplicate
+# label check and the early blocks are those of a serial load.
+#
+# A worker parses a file with the state that the parent had when it forked. Ren'Py runs python early blocks (and
+# some early config values) while it loads a file, and they can change how later files parse (a statement that
+# renpy.register_statement added, for example). So the files are compiled in waves. A wave ends with a file that
+# has such a block (renpy.scriptscan.scan_early), or whose text is not known, and the next wave is forked when the
+# parent has loaded that file.
+#
+# Where there is no fork (Windows), with fewer than two workers or with little to compile, nothing is done and the
+# load is serial.
+
+import hashlib
+import os
+import select
+import signal
+import sys
+
+import renpy
+import renpy.script
+import renpy.scriptscan
+
+# The number of worker processes: RENPY_PARALLEL_COMPILE=N (0 or 1: none), else two less than the CPU count, at most 4.
+MAX_WORKERS = 4
+
+# A wave with less source than this (bytes) is not worth a fork.
+MIN_WAVE_BYTES = 96 * 1024
+
+# Names that a worker makes for the nodes of file number `index` start at (index % 1000 + 1) * SERIAL_STRIDE. So they
+# are unique in a script, and the same for every run.
+SERIAL_STRIDE = 4000000
+
+
+def worker_count():
+    value = os.environ.get("RENPY_PARALLEL_COMPILE")
+
+    if value is not None:
+        try:
+            return max(0, min(int(value), 64))
+        except ValueError:
+            return 0
+
+    return max(0, min((os.cpu_count() or 1) - 2, MAX_WORKERS))
+
+
+class Wave:
+    """
+    A group of files that workers compile together.
+
+    `start`
+        The index (in the list of script files) of the first file after the barrier before this wave. The workers
+        are forked when the load reaches it.
+
+    `items`
+        A list of (index, fn, dir, source extension, size).
+    """
+
+    def __init__(self, start, items):
+        self.start = start
+        self.items = items
+        self.pending = {i[0] for i in items}
+        self.pids = {}  # pid -> set of the indexes it still owes
+        self.fd = None
+        self.buffer = b""
+        self.started = False
+
+    def workers(self, count):
+        """
+        Splits the items into at most `count` lists with about the same total size (the largest file goes to the
+        list with the least work). Each list is in load order, so the files that the load needs first come first.
+        """
+
+        count = max(1, min(count, len(self.items)))
+        lists = [[] for _ in range(count)]
+        load = [0] * count
+
+        for item in sorted(self.items, key=lambda i: -i[4]):
+            n = load.index(min(load))
+            lists[n].append(item)
+            load[n] += item[4]
+
+        for items in lists:
+            items.sort()
+
+        return [i for i in lists if i]
+
+    def start_workers(self, script, count):
+        self.started = True
+        read_fd, write_fd = os.pipe()
+
+        for items in self.workers(count):
+            try:
+                pid = os.fork()
+            except OSError:
+                break
+
+            if pid == 0:
+                code = 1
+
+                try:
+                    os.close(read_fd)
+                    self.run_worker(script, items, write_fd)
+                    code = 0
+                finally:
+                    os._exit(code)
+
+            self.pids[pid] = {i[0] for i in items}
+
+        os.close(write_fd)
+        self.fd = read_fd
+
+        if not self.pids:
+            self.pending.clear()
+
+    @staticmethod
+    def run_worker(script, items, write_fd):
+        """
+        The worker process: compiles each file as the load would, which writes its .rpyc. Whatever else the
+        compile does stays in this process.
+        """
+
+        for index, fn, dir, source, _size in items:
+            script.serial = (index % 1000 + 1) * SERIAL_STRIDE
+
+            try:
+                script.load_file(dir, fn + source)
+            except BaseException:
+                pass
+
+            # The file is done, compiled or not. If it did not compile, the load compiles it and shows the error.
+            os.write(write_fd, b"%d\n" % index)
+
+    def reap(self):
+        """
+        Notes the workers that ended. What they still owed is given up: the load compiles it.
+        """
+
+        for pid in list(self.pids):
+            try:
+                done, _status = os.waitpid(pid, os.WNOHANG)
+            except ChildProcessError:
+                done = pid
+
+            if done:
+                self.pending -= self.pids.pop(pid)
+
+    def wait(self, index):
+        """
+        Returns when the file `index` is compiled, or when it will not be.
+        """
+
+        while index in self.pending:
+            ready, _, _ = select.select([self.fd], [], [], 0.25)
+
+            if not ready:
+                self.reap()
+                continue
+
+            data = os.read(self.fd, 65536)
+
+            if not data:
+                # Every worker closed the pipe: nothing more comes.
+                self.reap()
+                self.pending.clear()
+                break
+
+            self.buffer += data
+            *lines, self.buffer = self.buffer.split(b"\n")
+
+            for line in lines:
+                if not line:
+                    continue
+
+                done = int(line)
+                self.pending.discard(done)
+
+                for owed in self.pids.values():
+                    owed.discard(done)
+
+    def stop(self):
+        """
+        Ends the workers that still run (the load stopped early) and reaps them. Closes the pipe.
+        """
+
+        for pid in self.pids:
+            try:
+                os.kill(pid, signal.SIGTERM)
+            except OSError:
+                pass
+
+            try:
+                os.waitpid(pid, 0)
+            except OSError:
+                pass
+
+        self.pids.clear()
+        self.pending.clear()
+
+        if self.fd is not None:
+            os.close(self.fd)
+            self.fd = None
+
+
+class Plan:
+    """
+    The waves for one call of Script.load_script.
+    """
+
+    def __init__(self, script, waves, count):
+        self.script = script
+        self.waves = waves
+        self.count = count
+        self.next = 0  # The index in self.waves of the next wave to start.
+        self.by_file = {}
+
+        for wave in waves:
+            for item in wave.items:
+                self.by_file[item[0]] = wave
+
+    def before(self, index):
+        """
+        Called before the load looks at the file `index`: starts the wave that the load has reached.
+        """
+
+        while self.next < len(self.waves) and self.waves[self.next].start <= index:
+            self.waves[self.next].start_workers(self.script, self.count)
+            self.next += 1
+
+    def wait(self, index):
+        """
+        Called before the load reads the file `index`: waits until its worker is done with it.
+        """
+
+        wave = self.by_file.get(index)
+
+        if wave is not None and wave.started:
+            wave.wait(index)
+
+    def finish(self):
+        for wave in self.waves:
+            if wave.started:
+                wave.stop()
+
+
+def source_of(script, dir, fn, source_extensions):
+    """
+    Returns (source extension, path, bytes) of the source file of a script, or None if it has none.
+    """
+
+    found = []
+
+    for source in source_extensions:
+        rpyfn = dir + "/" + fn + source
+
+        if renpy.vfs.exists(rpyfn):
+            found.append((source, rpyfn))
+
+    if len(found) != 1:
+        return None
+
+    source, rpyfn = found[0]
+
+    try:
+        with renpy.vfs.open(rpyfn, "rb") as f:
+            return source, rpyfn, f.read()
+    except Exception:
+        return None
+
+
+def plan(script, script_files):
+    """
+    Returns a Plan for `script_files` (the list that Script.load_script loads), or None when the load should
+    be serial. This only reads files. The script is not changed.
+    """
+
+    count = worker_count()
+
+    # No fork on macOS: a child of a process with Cocoa or Metal threads can crash in the ObjC runtime.
+    if count < 2 or not hasattr(os, "fork") or sys.platform == "darwin" or not renpy.config.player_cache_dir:
+        return None
+
+    force = renpy.game.args.compile  # type: ignore
+    legacy = renpy.script.renpy_8_game()
+    waves = []
+    items = []
+    start = None  # The first index of the wave that is being built.
+    size = 0
+
+    def close(next_start):
+        nonlocal items, start, size
+
+        if items and size >= MIN_WAVE_BYTES:
+            waves.append(Wave(start, items))
+
+        items = []
+        size = 0
+        start = next_start
+
+    for index, (_priority, fn, dir) in enumerate(script_files):
+        if dir == renpy.config.commondir:
+            continue
+
+        if (fn, dir) in script.loaded_scripts or not script.script_filter(fn, dir):
+            continue
+
+        if start is None:
+            start = index
+
+        if dir is None:
+            # A compiled file in an archive: its early blocks are not known.
+            close(index + 1)
+            continue
+
+        found = source_of(script, dir, fn, ["_ren.py", ".rpy"])
+
+        if found is None:
+            # A compiled file with no source, or a conflict that load_script reports.
+            close(index + 1)
+            continue
+
+        source, rpyfn, data = found
+
+        rpydigest = hashlib.md5(data + renpy.script.RPYC_MAGIC).digest()
+        legacydigest = hashlib.md5(data).digest() if legacy else None
+
+        # The test of Script.load_appropriate_file: a compiled file in the player cache or next to the source.
+        cachedigest = renpy.script.read_rpyc_digest(renpy.script.player_rpyc_path(dir, fn + ".rpyc"))
+        gamedigest = renpy.script.read_rpyc_digest(dir + "/" + fn + ".rpyc")
+
+        valid = not force and (
+            (cachedigest is not None and cachedigest == rpydigest)
+            or (gamedigest is not None and gamedigest in (rpydigest, legacydigest))
+        )
+
+        if not valid:
+            items.append((index, fn, dir, source, len(data)))
+            size += len(data)
+
+        if source == "_ren.py" or renpy.scriptscan.scan_early(data.decode("utf-8", "replace")):
+            close(index + 1)
+
+    close(None)
+
+    if not waves:
+        return None
+
+    return Plan(script, waves, count)
