diff --git a/renpy/scriptscan.py b/renpy/scriptscan.py
new file mode 100644
--- /dev/null
+++ b/renpy/scriptscan.py
@@ -0,0 +1,85 @@
+# Player patch: a fast scan of the text of a script file, without the lexer.
+#
+# The scan finds the labels of the file and whether the file can change how later files are parsed, which is what the
+# parallel compile of renpy.parallelcompile needs to know. It reads lines, not tokens, so it is only a hint:
+# the labels it finds are the names a reader sees in the text, and the parser stays the authority for the script.
+
+import re
+
+# Ren'Py runs `python early` blocks (and a few `define config.` statements) while it loads a file, before it parses
+# the next one. They can register statements and set the options that the parser reads. A file that has one is a
+# barrier: the files after it are parsed only when it has been loaded. These are the config names that the parser
+# reads and that Ren'Py sets early (renpy.ast.EARLY_CONFIG, read in renpy.parser, renpy.lexer, renpy.sl2.slparser).
+EARLY_RE = re.compile(
+    r"\bpython[ \t]+early\b|\bconfig\.(?:keyword_after_python|check_conflicting_properties|check_translate_none|munge_in_strings)\b"
+)
+
+LABEL_RE = re.compile(r"[ \t]*label[ \t]+(\.?[A-Za-z_\u0080-\uffff][\w\u0080-\uffff]*)")
+
+
+class ScanResult:
+    """
+    `labels`
+        A list of (name, line number) in file order. A label that starts with a dot is joined to the global label
+        before it, as Ren'Py does.
+
+    `early`
+        True if the file has a python early block or sets a config value that the parser reads.
+    """
+
+    __slots__ = ("labels", "early")
+
+    def __init__(self, labels, early):
+        self.labels = labels
+        self.early = early
+
+
+def scan_early(text):
+    """
+    Returns True if `text` has a python early block or sets a config value that the parser reads.
+    """
+
+    return EARLY_RE.search(text) is not None
+
+
+def scan_labels(text):
+    """
+    Returns the list of (name, line number) of the label statements in `text`.
+    """
+
+    rv = []
+    quote = None  # The open triple quote, if the line is inside a string.
+    parent = None
+
+    for number, line in enumerate(text.splitlines(), 1):
+        if quote is None:
+            m = LABEL_RE.match(line)
+
+            if m is not None:
+                name = m.group(1)
+
+                if name[0] == ".":
+                    name = (parent + name) if parent else name
+                else:
+                    parent = name
+
+                rv.append((name, number))
+
+        # Track triple quoted strings, which can hold lines that look like statements.
+        for m in re.finditer(r'"""|\'\'\'', line):
+            token = m.group(0)
+
+            if quote is None:
+                quote = token
+            elif quote == token:
+                quote = None
+
+    return rv
+
+
+def scan(text):
+    """
+    Scans `text`, the source of a script file, and returns a ScanResult.
+    """
+
+    return ScanResult(scan_labels(text), scan_early(text))
